# A steel body with a floatation bladder.
scene "Submarine 5"

water1 = plane(w: 25cm, d: 25cm, t: 2mm) color: deepskyblue
sub1 = capsule(r: 2.5cm, h: 8cm) at (0, 10cm, 0) material: steel
bladder1 = sphere(r: 3.5cm) at (0, 12cm, 0) material: plastic color: orangered
simulate: float
ask "will it float?"
