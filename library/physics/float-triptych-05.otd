# Three materials, one waterline test.
scene "Density Trio 5"

water1 = plane(w: 30cm, d: 30cm, t: 2mm) color: deepskyblue
c1 = sphere(r: 3cm) at (-9cm, 13cm, 0) material: brass
c2 = sphere(r: 3cm) at (0cm, 12cm, 0) material: stainless
c3 = sphere(r: 3cm) at (9cm, 12cm, 0) material: pine
simulate: float
ask "density?"
