# Three materials, one waterline test.
scene "Density Trio 3"

water1 = plane(w: 30cm, d: 30cm, t: 2mm) color: deepskyblue
c1 = sphere(r: 3cm) at (-9cm, 12cm, 0) material: glass
c2 = sphere(r: 3cm) at (0cm, 10cm, 0) material: silver
c3 = sphere(r: 3cm) at (9cm, 13cm, 0) material: tungsten
simulate: float
ask "density?"
