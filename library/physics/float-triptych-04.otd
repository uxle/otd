# Three materials, one waterline test.
scene "Density Trio 4"

water1 = plane(w: 30cm, d: 30cm, t: 2mm) color: deepskyblue
c1 = sphere(r: 3cm) at (-9cm, 14cm, 0) material: stainless
c2 = sphere(r: 3cm) at (0cm, 12cm, 0) material: glass
c3 = sphere(r: 3cm) at (9cm, 12cm, 0) material: wood
simulate: float
ask "density?"
