# Gears with 17 teeth each, rotated to interlock.
scene "Meshing Gears 8"

material: iron
define tooth = cube(w: 5mm, h: 8mm, d: 6mm)
define gearA(r) = group(cylinder(r: r, height: 6mm), ring(n: 17, radius: r + 3mm) tooth rotate (0, a, 0))
wheelA = gearA(r: 30mm)
wheelB = gearA(r: 19mm) at (55mm, 0, 0) rotate (0, 14.9deg, 0)
ask "mass?"
