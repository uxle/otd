# Gears with 22 teeth each, rotated to interlock.
scene "Meshing Gears 7"

material: copper
define tooth = cube(w: 5mm, h: 8mm, d: 6mm)
define gearA(r) = group(cylinder(r: r, height: 6mm), ring(n: 22, radius: r + 3mm) tooth rotate (0, a, 0))
wheelA = gearA(r: 21mm)
wheelB = gearA(r: 27mm) at (54mm, 0, 0) rotate (0, 11deg, 0)
ask "mass?"
