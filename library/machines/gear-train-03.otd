# Three gears in a row.
scene "Gear Train 3"

material: steel
define tooth = cube(w: 4mm, h: 7mm, d: 5mm)
define gearX(r, n) = group(cylinder(r: r, height: 5mm), ring(n: n, radius: r + 2.5mm) tooth rotate (0, a, 0))
g1 = gearX(r: 28mm, n: 12) at (0mm, 0, 0) color: silver
g2 = gearX(r: 23mm, n: 17) at (61mm, 0, 0) color: silver
g3 = gearX(r: 17mm, n: 10) at (112mm, 0, 0) color: gold
ask "how many objects?"
