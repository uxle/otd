# Gears with 18 teeth each, rotated to interlock.
scene "Meshing Gears 6"

material: bronze
define tooth = cube(w: 5mm, h: 8mm, d: 6mm)
define gearA(r) = group(cylinder(r: r, height: 6mm), ring(n: 18, radius: r + 3mm) tooth rotate (0, a, 0))
wheelA = gearA(r: 20mm)
wheelB = gearA(r: 22mm) at (48mm, 0, 0) rotate (0, 12.3deg, 0)
ask "mass?"
