# Gears with 13 teeth each, rotated to interlock.
scene "Meshing Gears 2"

material: titanium
define tooth = cube(w: 5mm, h: 8mm, d: 6mm)
define gearA(r) = group(cylinder(r: r, height: 6mm), ring(n: 13, radius: r + 3mm) tooth rotate (0, a, 0))
wheelA = gearA(r: 30mm)
wheelB = gearA(r: 33mm) at (69mm, 0, 0) rotate (0, 9.1deg, 0)
ask "mass?"
