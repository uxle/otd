# Gears with 23 teeth each, rotated to interlock.
scene "Meshing Gears 3"

material: gold
define tooth = cube(w: 5mm, h: 8mm, d: 6mm)
define gearA(r) = group(cylinder(r: r, height: 6mm), ring(n: 23, radius: r + 3mm) tooth rotate (0, a, 0))
wheelA = gearA(r: 28mm)
wheelB = gearA(r: 17mm) at (51mm, 0, 0) rotate (0, 10.2deg, 0)
ask "mass?"
