# Two meshing 20-tooth steel gears, half a tooth-pitch apart.
scene "Gear Pair"

material: steel
define tooth = cube(w: 5mm, h: 8mm, d: 6mm)
define gear(r) = group(cylinder(r: r, height: 6mm), ring(n: 20, radius: r + 3mm) tooth rotate (0, a, 0))
gearA = gear(r: 30mm) color: silver
gearB = gear(r: 30mm) at (66mm, 0, 0) rotate (0, 9deg, 0) color: gold
ask "mass?"
