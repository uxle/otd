# Three gears in a row.
scene "Gear Train 1"

material: steel
define tooth = cube(w: 4mm, h: 7mm, d: 5mm)
define gearX(r, n) = group(cylinder(r: r, height: 5mm), ring(n: n, radius: r + 2.5mm) tooth rotate (0, a, 0))
g1 = gearX(r: 25mm, n: 13) at (0mm, 0, 0) color: gold
g2 = gearX(r: 21mm, n: 18) at (55mm, 0, 0) color: silver
g3 = gearX(r: 28mm, n: 17) at (102mm, 0, 0) color: silver
ask "how many objects?"
