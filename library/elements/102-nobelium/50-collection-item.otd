# Collection Item
# Nobelium (No) — real density 9.9 g/cm³. display stand + sphere, like an element collection.
scene "Nobelium Collection Item"

stand = cylinder(r: 26mm, h: 5mm) color: #303038 at (0, 2.5mm, 0)
