# Display Card
# Rutherfordium (Rf) — real density 23.2 g/cm³. periodic-table tile.
scene "Rutherfordium Display Card"

tile = cube(w: 64mm, d: 6mm, h: 64mm) color: #50d0ff at (0, 3mm, 0)
sym = text "Rf" at (-14mm, 6mm, -8mm)
znum = text "104" at (22mm, 6mm, 22mm)
nmass = text "267" at (-22mm, 6mm, 22mm)
