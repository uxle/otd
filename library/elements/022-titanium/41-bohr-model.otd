# Bohr Model
# Titanium (Ti) — real density 4.506 g/cm³. nucleus + first shells, tilted for depth.
scene "Titanium Bohr Model"

define electron = sphere 1.1mm color: #ffffff
nucleus = sphere 3mm color: #bfc2c7
orb1 = ring(n: 2, radius: 6mm) electron rotate (0, a, 0)
orb2 = ring(n: 8, radius: 12mm) electron rotate (0, a, 0)
orb3 = ring(n: 10, radius: 18mm) electron rotate (0, a, 0)
