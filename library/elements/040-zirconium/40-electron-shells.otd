# Electron Shells
# Zirconium (Zr) — real density 6.52 g/cm³. configuration [Kr] 4d2 5s2.
scene "Zirconium Electron Shells"

define electron = sphere 1mm color: #ffffff
nucleus = sphere 2.5mm color: #94e0e0
shell1 = ring(n: 2, radius: 5mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell2 = ring(n: 8, radius: 10mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell3 = ring(n: 18, radius: 15mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell4 = ring(n: 10, radius: 20mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell5 = ring(n: 2, radius: 25mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
