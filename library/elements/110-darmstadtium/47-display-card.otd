# Display Card
# Darmstadtium (Ds) — real density 34.8 g/cm³. periodic-table tile.
scene "Darmstadtium Display Card"

tile = cube(w: 64mm, d: 6mm, h: 64mm) color: #ff30d0 at (0, 3mm, 0)
sym = text "Ds" at (-14mm, 6mm, -8mm)
znum = text "110" at (22mm, 6mm, 22mm)
nmass = text "281" at (-22mm, 6mm, 22mm)
