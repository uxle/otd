# Collection Item
# Beryllium (Be) — real density 1.85 g/cm³. display stand + sphere, like an element collection.
scene "Beryllium Collection Item"

stand = cylinder(r: 26mm, h: 5mm) color: #303038 at (0, 2.5mm, 0)
pillar = cylinder(r: 5mm, h: 18mm) color: #505058 at (0, 14mm, 0)
gem = sphere 12mm color: #c2ff00 at (0, 44mm, 0)
plate = text "Be · 4" at (-14mm, 5mm, 30mm)
