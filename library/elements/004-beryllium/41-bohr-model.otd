# Bohr Model
# Beryllium (Be) — real density 1.85 g/cm³. nucleus + first shells, tilted for depth.
scene "Beryllium Bohr Model"

define electron = sphere 1.1mm color: #ffffff
nucleus = sphere 3mm color: #c2ff00
orb1 = ring(n: 2, radius: 6mm) electron rotate (0, a, 0)
orb2 = ring(n: 2, radius: 12mm) electron rotate (0, a, 0)
