# Display Card
# Livermorium (Lv) — real density 12.9 g/cm³. periodic-table tile.
scene "Livermorium Display Card"

tile = cube(w: 64mm, d: 6mm, h: 64mm) color: #ff9040 at (0, 3mm, 0)
sym = text "Lv" at (-14mm, 6mm, -8mm)
znum = text "116" at (22mm, 6mm, 22mm)
nmass = text "293" at (-22mm, 6mm, 22mm)
