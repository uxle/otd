# Stack Test
# Livermorium (Lv) — real density 12.9 g/cm³. three cubes stacked — simulate: collapse checks the load path.
scene "Livermorium Stack Test"

bottom = cube 20mm color: #ff9040 at (0, 10mm, 0)
middle = cube 20mm color: #ff9040 at (0, 30mm, 0)
top = cube 20mm color: #ff9040 at (0, 50mm, 0)
