# Stack Test
# Mendelevium (Md) — real density 10.3 g/cm³. three cubes stacked — simulate: collapse checks the load path.
scene "Mendelevium Stack Test"

bottom = cube 20mm color: #00ff80 at (0, 10mm, 0)
middle = cube 20mm color: #00ff80 at (0, 30mm, 0)
top = cube 20mm color: #00ff80 at (0, 50mm, 0)
