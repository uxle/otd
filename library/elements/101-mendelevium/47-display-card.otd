# Display Card
# Mendelevium (Md) — real density 10.3 g/cm³. periodic-table tile.
scene "Mendelevium Display Card"

tile = cube(w: 64mm, d: 6mm, h: 64mm) color: #00ff80 at (0, 3mm, 0)
sym = text "Md" at (-14mm, 6mm, -8mm)
znum = text "101" at (22mm, 6mm, 22mm)
nmass = text "258" at (-22mm, 6mm, 22mm)
