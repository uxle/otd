# Float Test
# Lead (Pb) — real density 11.34 g/cm³. Archimedes decides: ρ vs 0.997 g/cm³.
scene "Lead Float Test"

floater = cube 20mm material: lead at (0, 60mm, 0)
pool = cube(w: 90mm, d: 90mm, h: 35mm) material: water at (0, 17.5mm, 0)
# real verdict for Lead: sinks (density 11.34 g/cm³)
ask "will it float?"
simulate: float
