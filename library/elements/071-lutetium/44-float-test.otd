# Float Test
# Lutetium (Lu) — real density 9.841 g/cm³. Archimedes decides: ρ vs 0.997 g/cm³.
scene "Lutetium Float Test"

floater = cube 20mm color: #a6a6ff # stand-in mass for the demo at (0, 60mm, 0)
pool = cube(w: 90mm, d: 90mm, h: 35mm) material: water at (0, 17.5mm, 0)
# real verdict for Lutetium: sinks (density 9.841 g/cm³)
simulate: float
