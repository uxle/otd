# Electron Shells
# Sulfur (S) — real density 2.07 g/cm³. configuration [Ne] 3s2 3p4.
scene "Sulfur Electron Shells"

define electron = sphere 1mm color: #ffffff
nucleus = sphere 2.5mm color: #ffff30
shell1 = ring(n: 2, radius: 5mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell2 = ring(n: 8, radius: 10mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell3 = ring(n: 6, radius: 15mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
