# Collection Item
# Boron (B) — real density 2.34 g/cm³. display stand + sphere, like an element collection.
scene "Boron Collection Item"

stand = cylinder(r: 26mm, h: 5mm) color: #303038 at (0, 2.5mm, 0)
pillar = cylinder(r: 5mm, h: 18mm) color: #505058 at (0, 14mm, 0)
gem = sphere 12mm color: #ffb5b5 at (0, 44mm, 0)
plate = text "B · 5" at (-14mm, 5mm, 30mm)
