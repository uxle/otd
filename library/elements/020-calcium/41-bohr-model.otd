# Bohr Model
# Calcium (Ca) — real density 1.55 g/cm³. nucleus + first shells, tilted for depth.
scene "Calcium Bohr Model"

define electron = sphere 1.1mm color: #ffffff
nucleus = sphere 3mm color: #3dff00
orb1 = ring(n: 2, radius: 6mm) electron rotate (0, a, 0)
orb2 = ring(n: 8, radius: 12mm) electron rotate (0, a, 0)
orb3 = ring(n: 8, radius: 18mm) electron rotate (0, a, 0)
