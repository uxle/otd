# Electron Shells
# Lithium (Li) — real density 0.534 g/cm³. configuration [He] 2s1.
scene "Lithium Electron Shells"

define electron = sphere 1mm color: #ffffff
nucleus = sphere 2.5mm color: #cc80ff
shell1 = ring(n: 2, radius: 5mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell2 = ring(n: 1, radius: 10mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
