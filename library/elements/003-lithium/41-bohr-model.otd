# Bohr Model
# Lithium (Li) — real density 0.534 g/cm³. nucleus + first shells, tilted for depth.
scene "Lithium Bohr Model"

define electron = sphere 1.1mm color: #ffffff
nucleus = sphere 3mm color: #cc80ff
orb1 = ring(n: 2, radius: 6mm) electron rotate (0, a, 0)
orb2 = ring(n: 1, radius: 12mm) electron rotate (0, a, 0)
