# Float Test
# Cerium (Ce) — real density 6.77 g/cm³. Archimedes decides: ρ vs 0.997 g/cm³.
scene "Cerium Float Test"

floater = cube 20mm color: #ffd1d1 # stand-in mass for the demo at (0, 60mm, 0)
pool = cube(w: 90mm, d: 90mm, h: 35mm) material: water at (0, 17.5mm, 0)
# real verdict for Cerium: sinks (density 6.77 g/cm³)
simulate: float
