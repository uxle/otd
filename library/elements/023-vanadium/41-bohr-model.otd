# Bohr Model
# Vanadium (V) — real density 6.11 g/cm³. nucleus + first shells, tilted for depth.
scene "Vanadium Bohr Model"

define electron = sphere 1.1mm color: #ffffff
nucleus = sphere 3mm color: #a6a6ab
orb1 = ring(n: 2, radius: 6mm) electron rotate (0, a, 0)
orb2 = ring(n: 8, radius: 12mm) electron rotate (0, a, 0)
orb3 = ring(n: 11, radius: 18mm) electron rotate (0, a, 0)
