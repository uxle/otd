# Display Card
# Praseodymium (Pr) — real density 6.773 g/cm³. periodic-table tile.
scene "Praseodymium Display Card"

tile = cube(w: 64mm, d: 6mm, h: 64mm) color: #dfffaf at (0, 3mm, 0)
sym = text "Pr" at (-14mm, 6mm, -8mm)
znum = text "59" at (22mm, 6mm, 22mm)
nmass = text "141" at (-22mm, 6mm, 22mm)
