# Display Card
# Californium (Cf) — real density 15.1 g/cm³. periodic-table tile.
scene "Californium Display Card"

tile = cube(w: 64mm, d: 6mm, h: 64mm) color: #60ff30 at (0, 3mm, 0)
sym = text "Cf" at (-14mm, 6mm, -8mm)
znum = text "98" at (22mm, 6mm, 22mm)
nmass = text "251" at (-22mm, 6mm, 22mm)
