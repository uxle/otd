# Float Test
# Californium (Cf) — real density 15.1 g/cm³. Archimedes decides: ρ vs 0.997 g/cm³.
scene "Californium Float Test"

floater = cube 20mm color: #60ff30 # stand-in mass for the demo at (0, 60mm, 0)
pool = cube(w: 90mm, d: 90mm, h: 35mm) material: water at (0, 17.5mm, 0)
# real verdict for Californium: sinks (density 15.1 g/cm³)
simulate: float
