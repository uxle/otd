# Bohr Model
# Iron (Fe) — real density 7.874 g/cm³. nucleus + first shells, tilted for depth.
scene "Iron Bohr Model"

define electron = sphere 1.1mm color: #ffffff
nucleus = sphere 3mm color: #e06633
orb1 = ring(n: 2, radius: 6mm) electron rotate (0, a, 0)
orb2 = ring(n: 8, radius: 12mm) electron rotate (0, a, 0)
orb3 = ring(n: 14, radius: 18mm) electron rotate (0, a, 0)
