# Float Test
# Mercury (Hg) — real density 13.534 g/cm³. Archimedes decides: ρ vs 0.997 g/cm³.
scene "Mercury Float Test"

floater = cube 20mm material: mercury at (0, 60mm, 0)
pool = cube(w: 90mm, d: 90mm, h: 35mm) material: water at (0, 17.5mm, 0)
# real verdict for Mercury: sinks (density 13.534 g/cm³)
ask "will it float?"
simulate: float
