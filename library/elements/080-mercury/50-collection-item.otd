# Collection Item
# Mercury (Hg) — real density 13.534 g/cm³. display stand + sphere, like an element collection.
scene "Mercury Collection Item"

stand = cylinder(r: 26mm, h: 5mm) color: #303038 at (0, 2.5mm, 0)
