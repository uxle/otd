# Electron Shells
# Niobium (Nb) — real density 8.57 g/cm³. configuration [Kr] 4d4 5s1.
scene "Niobium Electron Shells"

define electron = sphere 1mm color: #ffffff
nucleus = sphere 2.5mm color: #73c2c9
shell1 = ring(n: 2, radius: 5mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell2 = ring(n: 8, radius: 10mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell3 = ring(n: 18, radius: 15mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell4 = ring(n: 12, radius: 20mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell5 = ring(n: 1, radius: 25mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
