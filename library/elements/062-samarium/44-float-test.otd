# Float Test
# Samarium (Sm) — real density 7.52 g/cm³. Archimedes decides: ρ vs 0.997 g/cm³.
scene "Samarium Float Test"

floater = cube 20mm color: #ff9b9b # stand-in mass for the demo at (0, 60mm, 0)
pool = cube(w: 90mm, d: 90mm, h: 35mm) material: water at (0, 17.5mm, 0)
# real verdict for Samarium: sinks (density 7.52 g/cm³)
simulate: float
