# Electron Shells
# Sodium (Na) — real density 0.971 g/cm³. configuration [Ne] 3s1.
scene "Sodium Electron Shells"

define electron = sphere 1mm color: #ffffff
nucleus = sphere 2.5mm color: #ab5cf2
shell1 = ring(n: 2, radius: 5mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell2 = ring(n: 8, radius: 10mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell3 = ring(n: 1, radius: 15mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
