# Display Card
# Protactinium (Pa) — real density 15.37 g/cm³. periodic-table tile.
scene "Protactinium Display Card"

tile = cube(w: 64mm, d: 6mm, h: 64mm) color: #00bfff at (0, 3mm, 0)
sym = text "Pa" at (-14mm, 6mm, -8mm)
znum = text "91" at (22mm, 6mm, 22mm)
nmass = text "231" at (-22mm, 6mm, 22mm)
