# Stack Test
# Protactinium (Pa) — real density 15.37 g/cm³. three cubes stacked — simulate: collapse checks the load path.
scene "Protactinium Stack Test"

bottom = cube 20mm color: #00bfff at (0, 10mm, 0)
middle = cube 20mm color: #00bfff at (0, 30mm, 0)
top = cube 20mm color: #00bfff at (0, 50mm, 0)
