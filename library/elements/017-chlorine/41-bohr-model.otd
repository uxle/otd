# Bohr Model
# Chlorine (Cl) — real density 0.0032 g/cm³. nucleus + first shells, tilted for depth.
scene "Chlorine Bohr Model"

define electron = sphere 1.1mm color: #ffffff
nucleus = sphere 3mm color: #1ff01f
orb1 = ring(n: 2, radius: 6mm) electron rotate (0, a, 0)
orb2 = ring(n: 8, radius: 12mm) electron rotate (0, a, 0)
orb3 = ring(n: 7, radius: 18mm) electron rotate (0, a, 0)
