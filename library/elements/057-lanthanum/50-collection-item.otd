# Collection Item
# Lanthanum (La) — real density 6.162 g/cm³. display stand + sphere, like an element collection.
scene "Lanthanum Collection Item"

stand = cylinder(r: 26mm, h: 5mm) color: #303038 at (0, 2.5mm, 0)
