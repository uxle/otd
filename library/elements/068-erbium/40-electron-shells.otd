# Electron Shells
# Erbium (Er) — real density 9.066 g/cm³. configuration [Xe] 4f12 6s2.
scene "Erbium Electron Shells"

define electron = sphere 1mm color: #ffffff
nucleus = sphere 2.5mm color: #94d9ff
shell1 = ring(n: 2, radius: 5mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell2 = ring(n: 8, radius: 10mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell3 = ring(n: 18, radius: 15mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell4 = ring(n: 30, radius: 20mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell5 = ring(n: 8, radius: 25mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell6 = ring(n: 2, radius: 30mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
