# Float Test
# Hassium (Hs) — real density 40.7 g/cm³. Archimedes decides: ρ vs 0.997 g/cm³.
scene "Hassium Float Test"

floater = cube 20mm color: #c060ff # stand-in mass for the demo at (0, 60mm, 0)
pool = cube(w: 90mm, d: 90mm, h: 35mm) material: water at (0, 17.5mm, 0)
# real verdict for Hassium: sinks (density 40.7 g/cm³)
simulate: float
