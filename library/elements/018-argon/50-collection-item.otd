# Collection Item
# Argon (Ar) — real density 0.0018 g/cm³. display stand + sphere, like an element collection.
scene "Argon Collection Item"

stand = cylinder(r: 26mm, h: 5mm) color: #303038 at (0, 2.5mm, 0)
pillar = cylinder(r: 5mm, h: 18mm) color: #505058 at (0, 14mm, 0)
gem = sphere 12mm color: #80d1e3 at (0, 44mm, 0)
plate = text "Ar · 18" at (-14mm, 5mm, 30mm)
