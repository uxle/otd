# Collection Item
# Barium (Ba) — real density 3.51 g/cm³. display stand + sphere, like an element collection.
scene "Barium Collection Item"

stand = cylinder(r: 26mm, h: 5mm) color: #303038 at (0, 2.5mm, 0)
pillar = cylinder(r: 5mm, h: 18mm) color: #505058 at (0, 14mm, 0)
gem = sphere 12mm color: #00c900 at (0, 44mm, 0)
plate = text "Ba · 56" at (-14mm, 5mm, 30mm)
