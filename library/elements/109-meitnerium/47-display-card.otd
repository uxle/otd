# Display Card
# Meitnerium (Mt) — real density 37.4 g/cm³. periodic-table tile.
scene "Meitnerium Display Card"

tile = cube(w: 64mm, d: 6mm, h: 64mm) color: #d040ff at (0, 3mm, 0)
sym = text "Mt" at (-14mm, 6mm, -8mm)
znum = text "109" at (22mm, 6mm, 22mm)
nmass = text "278" at (-22mm, 6mm, 22mm)
