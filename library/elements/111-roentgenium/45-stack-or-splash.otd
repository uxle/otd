# Stack Test
# Roentgenium (Rg) — real density 28.7 g/cm³. three cubes stacked — simulate: collapse checks the load path.
scene "Roentgenium Stack Test"

bottom = cube 20mm color: #ff2060 at (0, 10mm, 0)
middle = cube 20mm color: #ff2060 at (0, 30mm, 0)
top = cube 20mm color: #ff2060 at (0, 50mm, 0)
