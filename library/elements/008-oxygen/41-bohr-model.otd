# Bohr Model
# Oxygen (O) — real density 0.00143 g/cm³. nucleus + first shells, tilted for depth.
scene "Oxygen Bohr Model"

define electron = sphere 1.1mm color: #ffffff
nucleus = sphere 3mm color: #ff0d0d
orb1 = ring(n: 2, radius: 6mm) electron rotate (0, a, 0)
orb2 = ring(n: 6, radius: 12mm) electron rotate (0, a, 0)
