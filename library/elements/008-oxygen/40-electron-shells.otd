# Electron Shells
# Oxygen (O) — real density 0.00143 g/cm³. configuration [He] 2s2 2p4.
scene "Oxygen Electron Shells"

define electron = sphere 1mm color: #ffffff
nucleus = sphere 2.5mm color: #ff0d0d
shell1 = ring(n: 2, radius: 5mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
shell2 = ring(n: 6, radius: 10mm) electron rotate (0, a, 0) at (0, 0.5mm, 0)
