# Density Compare
# Oxygen (O) — real density 0.00143 g/cm³. equal masses: Oxygen vs water — sides ∝ (1/ρ)^(1/3).
scene "Oxygen Density Compare"

element_cube = cube 177.3mm color: #ff0d0d at (-20mm, 88.7mm, 0)
water_cube = cube 20mm material: water at (18mm, 10mm, 0)
# both cubes weigh the same: about 0.0 g — the water cube is the reference
