# Float Test
# Oxygen (O) — real density 0.00143 g/cm³. Archimedes decides: ρ vs 0.997 g/cm³.
scene "Oxygen Float Test"

# a gas like Oxygen does not float as a solid — bubbles rise THROUGH water
tank = cube(w: 80mm, d: 80mm, h: 50mm) material: water at (0, 25mm, 0)
bubbles = scatter(n: 10, radius: 20mm, seed: 8) sphere 3mm color: #ff0d0d
