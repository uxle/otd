# Stack Test
# Copernicium (Cn) — real density 23.7 g/cm³. three cubes stacked — simulate: collapse checks the load path.
scene "Copernicium Stack Test"

bottom = cube 20mm color: #ff1050 at (0, 10mm, 0)
middle = cube 20mm color: #ff1050 at (0, 30mm, 0)
top = cube 20mm color: #ff1050 at (0, 50mm, 0)
