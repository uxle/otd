# Display Card
# Copernicium (Cn) — real density 23.7 g/cm³. periodic-table tile.
scene "Copernicium Display Card"

tile = cube(w: 64mm, d: 6mm, h: 64mm) color: #ff1050 at (0, 3mm, 0)
sym = text "Cn" at (-14mm, 6mm, -8mm)
znum = text "112" at (22mm, 6mm, 22mm)
nmass = text "285" at (-22mm, 6mm, 22mm)
