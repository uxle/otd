# Display Card
# Einsteinium (Es) — real density 8.84 g/cm³. periodic-table tile.
scene "Einsteinium Display Card"

tile = cube(w: 64mm, d: 6mm, h: 64mm) color: #40ff10 at (0, 3mm, 0)
sym = text "Es" at (-14mm, 6mm, -8mm)
znum = text "99" at (22mm, 6mm, 22mm)
nmass = text "252" at (-22mm, 6mm, 22mm)
