# Bohr Model
# Fluorine (F) — real density 0.0017 g/cm³. nucleus + first shells, tilted for depth.
scene "Fluorine Bohr Model"

define electron = sphere 1.1mm color: #ffffff
nucleus = sphere 3mm color: #90e050
orb1 = ring(n: 2, radius: 6mm) electron rotate (0, a, 0)
orb2 = ring(n: 7, radius: 12mm) electron rotate (0, a, 0)
